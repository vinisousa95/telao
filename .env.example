# ─────────────────────────────────────────────────────────────────────────────
# Configuração do Monitor de Telão
# Copie este arquivo para .env e preencha os valores reais.
# ─────────────────────────────────────────────────────────────────────────────

# URL da página que o telão deve exibir (OBRIGATÓRIO)
TARGET_URL=https://sistema.empresa.com/dashboard/indicadores

# URL da página de login (padrão: igual a TARGET_URL se não informado)
LOGIN_URL=https://sistema.empresa.com/login

# Credenciais de acesso
TELAO_USERNAME=usuario_telao
TELAO_PASSWORD=senha_aqui

# ─── Seletores CSS dos elementos de login ────────────────────────────────────
# Ajuste conforme o HTML real do sistema

# Campo de usuário (padrão já tenta nomes comuns)
# USERNAME_SELECTOR=input[name="username"]

# Campo de senha
# PASSWORD_SELECTOR=input[name="password"]

# Botão de submit
# SUBMIT_SELECTOR=button[type="submit"]

# (Opcional) Seletor que confirma que o login foi bem-sucedido
# SUCCESS_INDICATOR=.dashboard-header

# ─── Comportamento ───────────────────────────────────────────────────────────

# Intervalo de verificação em segundos (padrão: 30)
CHECK_INTERVAL_SEC=30

# Timeout para ações de login em ms (padrão: 15000)
LOGIN_TIMEOUT_MS=15000

# Timeout para navegação em ms (padrão: 30000)
NAV_TIMEOUT_MS=30000

# Rodar sem janela visível? false = mostra o browser normalmente
HEADLESS=false

# ─── Modo CDP (avançado) ─────────────────────────────────────────────────────
# Se o Chrome já está rodando com --remote-debugging-port=9222, informe aqui.
# Deixe vazio para o script lançar um browser próprio (modo recomendado).
# CDP_URL=http://localhost:9222
